keybind = ctrl+d=close_surface
font-family="JetBrainsMono Nerd Font"
font-style=Bold
font-size=15
font-synthetic-style=bold
font-thicken=true
font-thicken-strength=255
font-feature = calt
theme = Catppuccin Mocha
shell-integration = detect
shell-integration-features = title, ssh-env, cursor, sudo
cursor-opacity=1
cursor-style=bar
cursor-click-to-move=true
cursor-style-blink=true
alpha-blending=native
background-opacity=1
background-opacity-cells=false
background-blur=1
link-url=true
link-previews=true
window-theme = ghostty
#macos-titlebar-proxy-icon=hidden
#macos-titlebar-style=transparent
#macos-window-buttons=hidden
custom-shader="~/.config/ghostty/shaders/cursor_smear.glsl"

config-file =./keybinds/tab_split
config-file =./keybinds/actions_keybind
